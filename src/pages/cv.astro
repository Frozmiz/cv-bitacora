---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { cv } from '../config/site';

type CvLocale = keyof typeof cv.files;

const localeEntries = Object.entries(cv.files) as [CvLocale, (typeof cv.files)[CvLocale]][];

const availability = Object.fromEntries(
  localeEntries.map(([key, file]) => {
    const diskPath = path.join(process.cwd(), 'public', file.path.replace(/^\//, ''));
    return [key, fs.existsSync(diskPath)];
  }),
) as Record<CvLocale, boolean>;

const initialLocale =
  (availability[cv.defaultLocale] ? cv.defaultLocale : null) ??
  localeEntries.find(([key]) => availability[key])?.[0] ??
  cv.defaultLocale;

const initialFile = cv.files[initialLocale];
---

<Layout
  title="CV en PDF"
  description={`Currículum de ${cv.label} en formato PDF.`}
>
  <section class="cv-page" aria-labelledby="cv-page-title">
    <header class="cv-page__header">
      <a href="/" class="cv-page__back">← Volver al portfolio</a>
      <h1 id="cv-page-title" class="cv-page__title">Currículum vitae</h1>
      <p class="cv-page__subtitle">{cv.label}</p>
    </header>

    <div
      class="cv-page__locale"
      role="tablist"
      aria-label="Idioma del currículum"
    >
      {localeEntries.map(([key, file]) => (
        <button
          type="button"
          role="tab"
          class="cv-page__locale-btn"
          data-locale={key}
          data-file={file.path}
          data-label={file.label}
          aria-selected={key === initialLocale ? 'true' : 'false'}
          aria-controls="cv-viewer-panel"
          id={`cv-tab-${key}`}
          disabled={!availability[key]}
        >
          {file.label}
        </button>
      ))}
    </div>

    {initialLocale && availability[initialLocale] ? (
      <div
        id="cv-viewer-panel"
        class="cv-page__viewer"
        role="tabpanel"
        aria-labelledby={`cv-tab-${initialLocale}`}
      >
        <div class="cv-page__toolbar">
          <a
            id="cv-open-link"
            href={initialFile.path}
            target="_blank"
            rel="noopener noreferrer"
            class="cv-page__btn cv-page__btn--primary"
          >
            Abrir en pestaña nueva
          </a>
          <a
            id="cv-download-link"
            href={initialFile.path}
            download
            class="cv-page__btn cv-page__btn--ghost"
          >
            Descargar PDF
          </a>
        </div>
        <iframe
          id="cv-frame"
          class="cv-page__frame"
          src={`${initialFile.path}#view=FitH`}
          title={`CV de ${cv.label} (${initialFile.label})`}
        />
      </div>
    ) : (
      <div class="cv-page__missing" role="status">
        <p class="cv-page__missing-title">PDF no encontrado</p>
        <p class="cv-page__missing-text">
          Añade los currículums en
          <code class="cv-page__code">public/cv/</code>
          y vuelve a desplegar el sitio.
        </p>
        <ul class="cv-page__missing-list">
          {localeEntries.map(([key, file]) => (
            <li>
              <code class="cv-page__code">public{file.path}</code>
              {!availability[key] && ' (no encontrado)'}
            </li>
          ))}
        </ul>
      </div>
    )}

    {initialLocale && availability[initialLocale] && !availability.en && (
      <p class="cv-page__note" role="status">
        CV English no disponible todavía. Añade
        <code class="cv-page__code">public{cv.files.en.path}</code>
        para completar la sincronización.
      </p>
    )}
  </section>
</Layout>

<script define:vars={{ cvLabel: cv.label }}>
  const tabs = document.querySelectorAll('.cv-page__locale-btn:not([disabled])');
  const frame = document.getElementById('cv-frame');
  const openLink = document.getElementById('cv-open-link');
  const downloadLink = document.getElementById('cv-download-link');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const file = tab.dataset.file;
      const label = tab.dataset.label;
      if (!file || !frame || !openLink || !downloadLink) return;

      tabs.forEach((other) => {
        other.setAttribute('aria-selected', other === tab ? 'true' : 'false');
      });

      frame.src = `${file}#view=FitH`;
      frame.title = `CV de ${cvLabel} (${label})`;
      openLink.href = file;
      downloadLink.href = file;
    });
  });
</script>

<style>
  .cv-page {
    padding-top: var(--spacing-section, 6rem);
    padding-bottom: var(--spacing-section, 6rem);
  }

  .cv-page__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .cv-page__back {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    color: #A1A1AA;
    text-decoration: none;
    width: fit-content;
    transition: color 150ms ease;
  }

  .cv-page__back:hover {
    color: #14B8A6;
  }

  .cv-page__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #EDEDED;
    margin: 0;
  }

  .cv-page__subtitle {
    font-size: 0.9375rem;
    color: #A1A1AA;
    margin: 0;
  }

  .cv-page__locale {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .cv-page__locale-btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    font-family: var(--font-mono, monospace);
    color: #A1A1AA;
    background-color: transparent;
    border: 1px solid #27272A;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      border-color 150ms ease;
  }

  .cv-page__locale-btn:hover:not(:disabled) {
    background-color: #1A1A1A;
    color: #EDEDED;
    border-color: #3F3F46;
  }

  .cv-page__locale-btn[aria-selected='true'] {
    background-color: #14B8A6;
    color: #0A0A0A;
    border-color: #14B8A6;
  }

  .cv-page__locale-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .cv-page__viewer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cv-page__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cv-page__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.625rem 1.25rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .cv-page__btn--primary {
    background-color: #EDEDED;
    color: #0A0A0A;
  }

  .cv-page__btn--primary:hover {
    opacity: 0.88;
  }

  .cv-page__btn--ghost {
    background-color: transparent;
    color: #A1A1AA;
    border: 1px solid #27272A;
  }

  .cv-page__btn--ghost:hover {
    background-color: #1A1A1A;
    color: #EDEDED;
    border-color: #3F3F46;
  }

  .cv-page__frame {
    width: 100%;
    min-height: calc(100dvh - 18rem);
    height: 80vh;
    border: 1px solid #27272A;
    border-radius: 0.75rem;
    background-color: #111111;
  }

  .cv-page__missing {
    background-color: #111111;
    border: 1px solid #27272A;
    border-radius: 0.75rem;
    padding: 2rem;
  }

  .cv-page__missing-title {
    font-size: 1rem;
    font-weight: 600;
    color: #EDEDED;
    margin: 0 0 0.75rem;
  }

  .cv-page__missing-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #A1A1AA;
    margin: 0 0 1rem;
  }

  .cv-page__missing-list {
    margin: 0;
    padding-left: 1.25rem;
    color: #A1A1AA;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .cv-page__code {
    font-family: var(--font-mono, monospace);
    font-size: 0.875em;
    color: #14B8A6;
  }

  .cv-page__note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: #F59E0B;
  }
</style>
