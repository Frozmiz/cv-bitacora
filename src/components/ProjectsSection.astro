---
import { getCollection } from 'astro:content';
import ProfessionalProjectCard from './ProfessionalProjectCard.astro';
import PersonalProjectCard from './PersonalProjectCard.astro';

/** Orden explícito de casos profesionales (experiencia real). */
const PROFESSIONAL_ORDER = ['finca-el-sarao', 'gtvmotor', 'slowork'] as const;

const allProjects = await getCollection('projects');

const byId = new Map(allProjects.map((p) => [p.id, p]));

const professionalProjects = PROFESSIONAL_ORDER.map((id) => byId.get(id)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);

const personalProjects = allProjects.filter((p) => p.data.kind === 'personal');
---

<section id="proyectos" class="projects-section">
  <header class="projects-section__header">
    <p class="projects-section__label">Portfolio</p>
    <h2 class="projects-section__title">Proyectos</h2>
  </header>

  <!-- Casos reales -->
  <div class="projects-group">
    <header class="projects-group__header">
      <h3 class="projects-group__title">Casos reales</h3>
      <p class="projects-group__intro">
        Productos desarrollados en entornos reales de cliente y startup.
      </p>
    </header>

    <ul class="projects-list" role="list" aria-label="Proyectos profesionales">
      {professionalProjects.map((project) => (
        <li class="projects-list__item">
          <ProfessionalProjectCard project={project} />
        </li>
      ))}
    </ul>
  </div>

  <!-- Proyecto personal -->
  {personalProjects.length > 0 && (
    <div class="projects-group projects-group--personal">
      <header class="projects-group__header">
        <h3 class="projects-group__title">Proyecto personal</h3>
        <p class="projects-group__intro">
          Portfolio técnico, documentación y experimentación.
        </p>
      </header>

      <ul class="projects-list projects-list--personal" role="list" aria-label="Proyectos personales">
        {personalProjects.map((project) => (
          <li class="projects-list__item">
            <PersonalProjectCard project={project} />
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .projects-section {
    padding-top: var(--spacing-section, 6rem);
    padding-bottom: var(--spacing-section, 6rem);
  }

  .projects-section__header {
    margin-bottom: 2.5rem; /* 40px: Proyectos → Casos reales */
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .projects-section__label {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #14b8a6;
    margin: 0;
  }

  .projects-section__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #ededed;
    margin: 0;
  }

  .projects-group {
    display: flex;
    flex-direction: column;
    gap: 1.5rem; /* 24px: group header → primera card */
  }

  .projects-group--personal {
    margin-top: 3.25rem; /* 52px: última pro card → separador personal */
    padding-top: 1rem; /* 16px: borde → título personal */
    border-top: 1px solid #27272a;
    gap: 1.125rem; /* 18px: subtítulo personal → card */
  }

  .projects-group__header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem; /* 6px: título → descripción */
    max-width: 62ch;
  }

  .projects-group__title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: #ededed;
    margin: 0;
  }

  .projects-group--personal .projects-group__title {
    color: #8b5cf6;
  }

  .projects-group__intro {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #a1a1aa;
    margin: 0;
  }

  .projects-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem; /* 24px entre cards profesionales */
    width: 100%;
  }

  @media (max-width: 640px) {
    .projects-list {
      gap: 1.125rem; /* 18px en mobile */
    }
  }

  .projects-list--personal {
    gap: 1rem;
  }

  .projects-list__item {
    width: 100%;
    min-width: 0;
  }
</style>
