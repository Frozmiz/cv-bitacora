---
import type { CollectionEntry } from 'astro:content';
import ArticleWireframe from './ArticleWireframe.astro';

interface Props {
  entry: CollectionEntry<'logbook'>;
  index?: number;
}

const LOGBOOK_CORNERS = ['tr', 'br'] as const;

const { entry, index = 0 } = Astro.props;
const corner = LOGBOOK_CORNERS[index % LOGBOOK_CORNERS.length];
const crop = ((index % 2) + 2) as 2 | 3;
const { date, headline, context, technologies, error, research, solution, learning } =
  entry.data;

/** Formatea la fecha en español: "10 jun 2026" */
const dateFormatted = new Intl.DateTimeFormat('es-ES', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(date);

/**
 * Convierte los backticks de un string en etiquetas <code> inline.
 * Necesario porque los campos del frontmatter son strings planos,
 * no markdown renderizado.
 */
function parseInlineCode(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/`([^`]+)`/g, '<code class="inline-code">$1</code>');
}
---

<article class="lb-entry" data-logbook-entry={entry.id}>
  <div class="lb-entry__decor" aria-hidden="true">
    <ArticleWireframe corner={corner} intensity="soft" crop={crop} />
  </div>

  <!-- Marcador de batalla sobre la línea del timeline -->
  <span class="lb-entry__marker" aria-hidden="true">
    <svg
      class="lb-entry__swords"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5" />
      <line x1="13" x2="19" y1="19" y2="13" />
      <line x1="16" x2="20" y1="16" y2="20" />
      <line x1="19" x2="21" y1="21" y2="19" />
      <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5" />
      <line x1="5" x2="9" y1="14" y2="18" />
      <line x1="7" x2="4" y1="17" y2="20" />
      <line x1="3" x2="5" y1="19" y2="21" />
    </svg>
  </span>

  <details class="lb-entry__details" id={`logbook-${entry.id}`}>
    <summary class="lb-entry__summary">
      <time
        datetime={date.toISOString().slice(0, 10)}
        class="lb-entry__date"
      >
        {dateFormatted}
      </time>
      <span class="lb-entry__headline">{headline}</span>
      <span class="lb-entry__toggle" aria-hidden="true">
        <svg
          class="lb-entry__chevron"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </span>
    </summary>

    <div class="lb-entry__panel">
      <header class="lb-entry__header">
        <h3 class="lb-entry__context">{context}</h3>

        <ul class="lb-entry__tech" aria-label="Tecnologías implicadas">
          {technologies.map((tech) => (
            <li><span class="pill">{tech}</span></li>
          ))}
        </ul>
      </header>

      <div class="lb-entry__body">
        <section class="lb-entry__block" aria-labelledby={`error-${entry.id}`}>
          <h4 id={`error-${entry.id}`} class="lb-entry__label lb-entry__label--error">
            <span aria-hidden="true">⚑</span> Error / Dificultad
          </h4>
          <div class="lb-entry__terminal">
            <span class="lb-entry__terminal-prompt" aria-hidden="true">$</span>
            <p class="lb-entry__terminal-text">{error}</p>
          </div>
        </section>

        <section class="lb-entry__block" aria-labelledby={`research-${entry.id}`}>
          <h4 id={`research-${entry.id}`} class="lb-entry__label lb-entry__label--research">
            <span aria-hidden="true">◎</span> Investigación
          </h4>
          <p class="lb-entry__text" data-search-field="research" set:html={parseInlineCode(research)} />
        </section>

        <section class="lb-entry__block" aria-labelledby={`solution-${entry.id}`}>
          <h4 id={`solution-${entry.id}`} class="lb-entry__label lb-entry__label--solution">
            <span aria-hidden="true">✓</span> Solución
          </h4>
          <p class="lb-entry__text" data-search-field="solution" set:html={parseInlineCode(solution)} />
        </section>

        <section class="lb-entry__block" aria-labelledby={`learning-${entry.id}`}>
          <h4 id={`learning-${entry.id}`} class="lb-entry__label lb-entry__label--learning">
            <span aria-hidden="true">→</span> Aprendizaje
          </h4>
          <p class="lb-entry__text" data-search-field="learning" set:html={parseInlineCode(learning)} />
        </section>
      </div>
    </div>
  </details>
</article>

<style>
  .lb-entry {
    position: relative;
    overflow: visible;
    padding-left: 2rem;
    padding-bottom: 0.75rem;
    min-width: 0;
  }

  /* Recorta solo el wireframe decorativo, no el summary interactivo */
  .lb-entry__decor {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .lb-entry > :not(.lb-entry__decor):not(.lb-entry__marker) {
    position: relative;
    z-index: 1;
  }

  .lb-entry:has(.lb-entry__details[open]) {
    padding-bottom: 3.5rem;
  }

  .lb-entry:has(.lb-entry__details:not([open])) .lb-entry__decor :global(.art-wire) {
    opacity: 0.35;
  }

  .lb-entry__marker {
    position: absolute;
    z-index: 2;
    left: calc(-2rem - 0.3125rem + 1px);
    top: 0.72rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    transform: translateX(-50%);
    color: #10b981;
    transition: color 200ms ease;
  }

  .lb-entry__marker::before {
    content: '';
    position: absolute;
    inset: -3px;
    background-color: #0a0a0a;
    border-radius: 3px;
    z-index: -1;
  }

  .lb-entry__marker::after {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1px solid #10b981;
    border-radius: 4px;
    opacity: 0.55;
    animation: lb-battle-pulse 2.8s ease-out infinite;
    pointer-events: none;
  }

  .lb-entry__swords {
    display: block;
    flex-shrink: 0;
  }

  @keyframes lb-battle-pulse {
    0% {
      transform: scale(0.9) rotate(-2deg);
      opacity: 0.55;
    }
    70% {
      transform: scale(1.35) rotate(2deg);
      opacity: 0;
    }
    100% {
      transform: scale(1.35) rotate(2deg);
      opacity: 0;
    }
  }

  .lb-entry:has(.lb-entry__details[open]) .lb-entry__marker {
    color: #14b8a6;
  }

  .lb-entry:has(.lb-entry__details[open]) .lb-entry__marker::after {
    border-color: #14b8a6;
    animation-duration: 2.1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .lb-entry__marker::after {
      animation: none;
      opacity: 0.3;
      transform: none;
    }
  }

  .lb-entry__details {
    margin: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .lb-entry__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem 1rem;
    list-style: none;
    cursor: pointer;
    padding: 0.5rem 0.75rem;
    margin: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    border-radius: 8px;
    border: 1px solid transparent;
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .lb-entry__summary::-webkit-details-marker {
    display: none;
  }

  .lb-entry__summary:hover {
    background-color: #111111;
    border-color: #27272a;
  }

  .lb-entry__details[open] > .lb-entry__summary {
    margin-bottom: 1rem;
    border-color: #27272a;
    background-color: #111111;
  }

  .lb-entry__date {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: #a1a1aa;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .lb-entry__headline {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: #ededed;
    line-height: 1.45;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .lb-entry__toggle {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: #a1a1aa;
    transition: color 200ms ease;
  }

  .lb-entry__summary:hover .lb-entry__toggle,
  .lb-entry__details[open] .lb-entry__toggle {
    color: #14b8a6;
  }

  .lb-entry__chevron {
    transition: transform 220ms ease;
  }

  .lb-entry__details[open] .lb-entry__chevron {
    transform: rotate(180deg);
  }

  .lb-entry__panel {
    padding-top: 0.25rem;
  }

  .lb-entry__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .lb-entry__context {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #a1a1aa;
    margin: 0;
    line-height: 1.55;
    max-width: 70ch;
  }

  .lb-entry__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }

  .lb-entry__body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lb-entry__block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lb-entry__label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .lb-entry__label--error    { color: #ef4444; }
  .lb-entry__label--research { color: #f59e0b; }
  .lb-entry__label--solution { color: #10b981; }
  .lb-entry__label--learning { color: #a1a1aa; }

  .lb-entry__terminal {
    display: flex;
    gap: 0.625rem;
    background-color: #1a1a1a;
    border: 1px solid #27272a;
    border-radius: 6px;
    padding: 0.875rem 1rem;
    max-width: 75ch;
  }

  .lb-entry__terminal-prompt {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    color: #ef4444;
    user-select: none;
    flex-shrink: 0;
    padding-top: 0.05em;
  }

  .lb-entry__terminal-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    line-height: 1.65;
    color: #a1a1aa;
    margin: 0;
    word-break: break-word;
  }

  .lb-entry__text {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: #a1a1aa;
    margin: 0;
    max-width: 72ch;
  }

  :global(.inline-code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    background-color: #1a1a1a;
    color: #14b8a6;
    padding: 0.1em 0.4em;
    border-radius: 3px;
    border: 1px solid #27272a;
  }

  @media (max-width: 640px) {
    .lb-entry__summary {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
    }

    .lb-entry__date {
      grid-column: 1 / -1;
    }

    .lb-entry__headline {
      grid-column: 1;
    }

    .lb-entry__toggle {
      grid-column: 2;
      grid-row: 2;
      align-self: center;
    }
  }
</style>
