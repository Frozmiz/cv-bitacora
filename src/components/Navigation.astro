---
import Icon from './ui/Icon.astro';
import type { IconName } from './ui/icons';

const links: { href: string; label: string; icon: IconName }[] = [
  { href: '#inicio', label: 'Inicio', icon: 'home' },
  { href: '#sobre-mi', label: 'Sobre mí', icon: 'user' },
  { href: '#proyectos', label: 'Proyectos', icon: 'monitor' },
  { href: '#bitacora', label: 'Bitácora', icon: 'code' },
];

const cvLink: { href: string; label: string; icon: IconName } = {
  href: '/cv',
  label: 'CV en PDF',
  icon: 'file-text',
};
---

<!--
  ── SIDEBAR (visible md+, oculto en mobile) ──────────────────────────────
-->
<nav
  class="sidebar"
  aria-label="Navegación principal"
>
  <!-- Logo / marca -->
  <a
    href="#inicio"
    class="sidebar__logo"
    aria-label="Inicio"
  >
    <span class="sidebar__logo-dot" aria-hidden="true"></span>
  </a>

  <!-- Enlace de navegación -->
  <ul class="sidebar__links" role="list">
    {links.map(({ href, label, icon }) => (
      <li>
        <a
          href={href}
          class="nav-link"
          aria-label={label}
          data-nav-link
        >
          <span class="nav-link__icon">
            <Icon name={icon} size={20} stroke-width={1.75} />
          </span>
          <span class="nav-link__tooltip">{label}</span>
        </a>
      </li>
    ))}
  </ul>

  <a
    href={cvLink.href}
    class="sidebar__cv nav-link"
    aria-label={cvLink.label}
  >
    <span class="nav-link__icon">
      <Icon name={cvLink.icon} size={20} stroke-width={1.75} />
    </span>
    <span class="nav-link__tooltip">{cvLink.label}</span>
  </a>
</nav>

<!--
  ── BOTTOM BAR (visible solo mobile, oculta md+) ─────────────────────────
-->
<nav
  class="bottom-bar"
  aria-label="Navegación (móvil)"
>
  {links.map(({ href, label, icon }) => (
    <a
      href={href}
      class="bottom-bar__link"
      aria-label={label}
      data-nav-link
    >
      <span class="bottom-bar__icon">
        <Icon name={icon} size={20} stroke-width={1.75} />
      </span>
      <span class="bottom-bar__label">{label}</span>
    </a>
  ))}
</nav>

<style>
  /* ── Variables locales ───────────────────────────────────────────────── */
  :root {
    --nav-bg:       #111111;
    --nav-border:   #27272A;
    --nav-accent:   #14B8A6;
    --nav-text-dim: #A1A1AA;
    --nav-w:        4rem;   /* 64px */
    --nav-h-mob:    3.5rem; /* 56px */
  }

  /* ── Sidebar ─────────────────────────────────────────────────────────── */
  .sidebar {
    display: none; /* oculto en mobile */
    position: fixed;
    top: 0;
    left: 0;
    width: var(--nav-w);
    height: 100dvh;
    background: var(--nav-bg);
    border-right: 1px solid var(--nav-border);
    flex-direction: column;
    align-items: center;
    padding: 1.25rem 0;
    gap: 0;
    z-index: 50;
  }

  @media (min-width: 768px) {
    .sidebar { display: flex; }
  }

  /* Logo dot */
  .sidebar__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-bottom: 1.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--nav-border);
    color: var(--nav-text-dim);
    transition: color 200ms ease;
    text-decoration: none;
  }
  .sidebar__logo:hover { color: var(--nav-accent); }

  .sidebar__logo-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--nav-accent);
  }

  .sidebar__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    flex: 1;
  }

  .sidebar__cv {
    margin-top: auto;
    border-top: 1px solid var(--nav-border);
    padding-top: 0.5rem;
  }

  /* ── Enlace genérico (sidebar) ───────────────────────────────────────── */
  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.875rem 0;
    color: var(--nav-text-dim);
    text-decoration: none;
    transition: color 200ms ease, background-color 200ms ease;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--nav-accent);
    background-color: #14b8a60d; /* acento al 5% */
  }

  .nav-link__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 0;
  }

  /* Tooltip flotante a la derecha del icono */
  .nav-link__tooltip {
    position: absolute;
    left: calc(var(--nav-w) + 0.5rem);
    white-space: nowrap;
    background: #1A1A1A;
    border: 1px solid var(--nav-border);
    border-radius: 4px;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-family: var(--font-mono, monospace);
    color: var(--nav-text-dim);
    pointer-events: none;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .nav-link:hover .nav-link__tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── Bottom Bar ──────────────────────────────────────────────────────── */
  .bottom-bar {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--nav-h-mob);
    background: var(--nav-bg);
    border-top: 1px solid var(--nav-border);
    align-items: center;
    justify-content: space-around;
    z-index: 50;
    padding: 0 0.5rem;
  }

  @media (min-width: 768px) {
    .bottom-bar { display: none; }
  }

  .bottom-bar__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    flex: 1;
    padding: 0.5rem 0;
    min-height: 44px; /* área táctil mínima DESIGN §8 */
    color: var(--nav-text-dim);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .bottom-bar__link:hover,
  .bottom-bar__link[aria-current="page"] {
    color: var(--nav-accent);
  }

  .bottom-bar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .bottom-bar__label {
    font-size: 0.6rem;
    font-family: var(--font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>

<script>
  /**
   * Marca el enlace activo según la sección visible usando IntersectionObserver.
   * Actualiza aria-current="page" en todos los [data-nav-link] que comparten href.
   */
  function initActiveNav() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    if (!links.length) return;

    const sectionIds = [...new Set([...links].map(l => l.getAttribute('href')?.slice(1)).filter(Boolean))] as string[];

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            links.forEach((link) => {
              const active = link.getAttribute('href') === `#${id}`;
              link.toggleAttribute('aria-current', active);
              if (active) link.setAttribute('aria-current', 'page');
              else link.removeAttribute('aria-current');
            });
          }
        }
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 },
    );

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  document.addEventListener('DOMContentLoaded', initActiveNav);
</script>
