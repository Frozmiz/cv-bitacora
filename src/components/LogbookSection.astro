---
import { getCollection } from 'astro:content';
import LogbookEntry from './LogbookEntry.astro';
import LogbookSearch from './LogbookSearch.astro';

/** Entradas ordenadas de más reciente a más antigua */
const entries = (await getCollection('logbook')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/**
 * Índice plano para Fuse.js (coincidencias aproximadas).
 * La búsqueda exacta se resuelve en el DOM; los campos deben alinearse con data-search-field.
 */
const searchIndex = JSON.stringify(
  entries.map((e) => ({
    id:           e.id,
    headline:     e.data.headline,
    summary:      e.data.summary,
    context:      e.data.context,
    error:        e.data.error,
    technologies: e.data.technologies,
    research:     e.data.research,
    solution:     e.data.solution,
    learning:     e.data.learning,
  })),
);
---

<section id="bitacora" class="logbook-section">
  <!-- Encabezado de sección -->
  <header class="logbook-section__header">
    <p class="logbook-section__label">Registro técnico</p>
    <h2 class="logbook-section__title">Bitácora</h2>
    <p class="logbook-section__subtitle">
      Aquí recopilo algunos de los fallos reales de los que he aprendido, a base de chocazos contra la pared,
      y que me recuerdan porque nunca voy a dejar de aprender dentro de este maravilloso mundo del software.
    </p>

    <div class="logbook-section__hint" role="note" aria-label="Cómo usar la bitácora">
      <span class="logbook-section__hint-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
        </svg>
      </span>
      <p class="logbook-section__hint-text">
        Cada caso muestra un titular descriptivo y un resumen del incidente. Con
        <strong>Ver diagnóstico</strong> se abre el detalle: contexto, error, investigación,
        solución y aprendizaje. También puedes usar el buscador.
      </p>
    </div>
  </header>

  <!--
    Timeline:
    El <ul> lleva el border-left que forma la línea vertical continua.
    Los marcadores de batalla (espadas cruzadas) de cada entrada se posicionan sobre esa línea.
    El último elemento no tiene padding-bottom para que la línea
    no sobrepase el último nodo (overflow: hidden en el ul).
  -->
  {entries.length > 0 ? (
    <div class="logbook-section__body">
      <LogbookSearch index={searchIndex} />

      <ul
        class="logbook-timeline"
        role="list"
        aria-label="Entradas de la bitácora"
      >
        {entries.map((entry, index) => (
          <li
            class:list={[
              'logbook-timeline__item',
              { 'logbook-timeline__item--last': index === entries.length - 1 },
            ]}
            data-entry-id={entry.id}
          >
            <LogbookEntry entry={entry} index={index} />
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <p class="logbook-section__empty">
      Aún no hay entradas en la bitácora.
    </p>
  )}

</section>

<style>
  /* ── Sección ─────────────────────────────────────────────────────────── */
  .logbook-section {
    padding-top: var(--spacing-section, 6rem);
    padding-bottom: var(--spacing-section, 6rem);
  }

  /* ── Encabezado ──────────────────────────────────────────────────────── */
  .logbook-section__header {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-width: 65ch;
  }

  .logbook-section__hint {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.875rem 1rem;
    max-width: 100%;
    background-color: #111111;
    border: 1px solid #27272a;
    border-left: 3px solid #14b8a6;
    border-radius: 8px;
  }

  .logbook-section__hint-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.05rem;
    color: #14b8a6;
    background-color: rgba(20, 184, 166, 0.1);
    border: 1px solid rgba(20, 184, 166, 0.35);
    border-radius: 50%;
  }

  .logbook-section__hint-text {
    margin: 0;
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #ededed;
  }

  .logbook-section__label {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #14B8A6;
    margin: 0;
  }

  .logbook-section__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #EDEDED;
    margin: 0;
  }

  .logbook-section__subtitle {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #A1A1AA;
    margin: 0.25rem 0 0;
  }

  .logbook-section__empty {
    font-size: 0.9375rem;
    color: #A1A1AA;
    font-family: var(--font-mono, monospace);
    margin: 0;
  }

  .logbook-section__body {
    min-width: 0;
  }

  /* ── Timeline (línea vertical continua) ─────────────────────────────── */
  .logbook-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;

    border-left: 1px solid #27272A;
    margin-left: 0.3125rem;
  }

  .logbook-timeline__item {
    min-width: 0;
  }

  .logbook-timeline__item--last {
    position: relative;
  }

  /* Tapar el tramo de línea por debajo del último nodo */
  .logbook-timeline__item--last::after {
    content: '';
    position: absolute;
    left: -2px;
    bottom: 0;
    width: 3px;
    height: 0.75rem;
    background-color: #0a0a0a;
    pointer-events: none;
  }

  .logbook-timeline__item--last :global(.lb-entry:has(.lb-entry__details[open])) {
    padding-bottom: 0;
  }

  /*
    Cuando Fuse oculta un elemento, display:none colapsa su altura a cero.
    La línea del <ul> continúa sin interrupciones porque border-left
    está en el ul, no en los li. Los elementos ocultos simplemente
    no contribuyen a la altura del contenedor.
  */
  .logbook-timeline__item[style*="display: none"] {
    pointer-events: none;
  }
</style>
