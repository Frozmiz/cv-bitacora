---
interface Props {
  /** JSON.stringify() del array de SearchItem: generado en LogbookSection */
  index: string;
}

const { index } = Astro.props;
---

<!--
  Custom Element <logbook-search>.
  El <script> de abajo lo define; Astro lo procesa con Vite/TS.
  El atributo data-index transporta el índice de búsqueda al cliente.
-->
<logbook-search data-index={index} class="ls-host">

  <div class="ls-wrapper">
    <!-- Icono de búsqueda decorativo -->
    <span class="ls-icon" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="15" height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
    </span>

    <input
      type="search"
      class="ls-input"
      placeholder="> Buscar por titular, error o tecnología (exacta o ~aprox)..."
      aria-label="Buscar en la bitácora"
      autocomplete="off"
      spellcheck="false"
    />

    <!--
      Contador de resultados: se actualiza vía JS.
      aria-live="polite" para lectores de pantalla.
    -->
    <span
      class="ls-count"
      aria-live="polite"
      aria-atomic="true"
    ></span>
  </div>

</logbook-search>

<script>
  import Fuse from 'fuse.js';

  interface SearchItem {
    id: string;
    headline: string;
    context: string;
    error: string;
    technologies: string[];
    research: string;
    solution: string;
    learning: string;
  }

  interface FuseMatch {
    key?: string;
    value?: string;
    indices?: ReadonlyArray<readonly [number, number]>;
  }

  const FIELD_SELECTORS: Record<string, string> = {
    headline: '.lb-entry__headline',
    context: '.lb-entry__context',
    error: '.lb-entry__terminal-text',
    research: '[data-search-field="research"]',
    solution: '[data-search-field="solution"]',
    learning: '[data-search-field="learning"]',
    technologies: '.lb-entry__tech .pill',
  };

  const SEARCH_TARGETS =
    '.lb-entry__headline, .lb-entry__context, .lb-entry__terminal-text, [data-search-field], .lb-entry__tech .pill';

  class LogbookSearch extends HTMLElement {
    #fuse: Fuse<SearchItem> | null = null;
    /** <li data-entry-id="..."> elements in the page */
    #entries: NodeListOf<HTMLElement> | null = null;
    #countEl: HTMLElement | null = null;
    #input: HTMLInputElement | null = null;

    connectedCallback() {
      const raw = this.dataset.index;
      if (!raw) return;

      const data = JSON.parse(raw) as SearchItem[];

      this.#fuse = new Fuse(data, {
        keys: [
          { name: 'headline',     weight: 0.35 },
          { name: 'error',        weight: 0.25 },
          { name: 'context',      weight: 0.2 },
          { name: 'technologies', weight: 0.1 },
          { name: 'research',     weight: 0.05 },
          { name: 'solution',     weight: 0.04 },
          { name: 'learning',     weight: 0.01 },
        ],
        threshold: 0.32,
        ignoreLocation: true,
        minMatchCharLength: 2,
        includeMatches: true,
      });

      this.#entries = document.querySelectorAll<HTMLElement>('[data-entry-id]');
      this.#countEl = this.querySelector<HTMLElement>('.ls-count');
      this.#input   = this.querySelector<HTMLInputElement>('input');

      this.#input?.addEventListener('input', (e) => {
        this.#handleInput((e.target as HTMLInputElement).value);
      });
    }

    #setEntryOpen(id: string, open: boolean) {
      const details = document.querySelector<HTMLDetailsElement>(
        `#logbook-${CSS.escape(id)}`,
      );
      if (details) details.open = open;
    }

    #escapeRegex(value: string): string {
      return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    #clearHighlights() {
      document.querySelectorAll('#bitacora mark.ls-hit').forEach((mark) => {
        mark.replaceWith(document.createTextNode(mark.textContent ?? ''));
      });
      document.querySelector('#bitacora')?.normalize();
    }

    #clearApproxBadges() {
      document.querySelectorAll('#bitacora .ls-approx').forEach((el) => el.remove());
    }

    #setApproxBadge(entryEl: HTMLElement, show: boolean) {
      const summary = entryEl.querySelector('.lb-entry__summary');
      if (!summary) return;

      const existing = summary.querySelector('.ls-approx');
      if (!show) {
        existing?.remove();
        return;
      }
      if (existing) return;

      const badge = document.createElement('span');
      badge.className = 'ls-approx';
      badge.textContent = '~aprox';
      badge.title = 'Coincidencia aproximada (no es el texto exacto buscado)';
      const headline = summary.querySelector('.lb-entry__headline');
      if (headline) headline.after(badge);
      else summary.insertBefore(badge, summary.querySelector('.lb-entry__toggle'));
    }

    #collectTextNodes(root: Element): Text[] {
      const textNodes: Text[] = [];
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);

      let node: Node | null;
      while ((node = walker.nextNode())) {
        const textNode = node as Text;
        if (textNode.parentElement?.closest('mark.ls-hit')) continue;
        if (textNode.nodeValue?.trim()) textNodes.push(textNode);
      }

      return textNodes;
    }

    #highlightTextNode(
      textNode: Text,
      pattern: RegExp,
      markClass = 'ls-hit',
    ): number {
      const text = textNode.nodeValue ?? '';
      pattern.lastIndex = 0;
      if (!pattern.test(text)) return 0;

      const re = new RegExp(pattern.source, pattern.flags);
      const fragment = document.createDocumentFragment();
      let lastIndex = 0;
      let match: RegExpExecArray | null;
      let hits = 0;

      while ((match = re.exec(text)) !== null) {
        const start = match.index;
        const matched = match[0];
        if (start > lastIndex) {
          fragment.appendChild(document.createTextNode(text.slice(lastIndex, start)));
        }
        const mark = document.createElement('mark');
        mark.className = markClass;
        mark.textContent = matched;
        fragment.appendChild(mark);
        hits++;
        lastIndex = start + matched.length;
        if (matched.length === 0) break;
      }

      if (hits === 0) return 0;

      if (lastIndex < text.length) {
        fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
      }

      textNode.parentNode?.replaceChild(fragment, textNode);
      return hits;
    }

    #highlightInRoot(root: Element, pattern: RegExp, markClass: string): number {
      let hits = 0;
      for (const textNode of this.#collectTextNodes(root)) {
        hits += this.#highlightTextNode(textNode, pattern, markClass);
      }
      return hits;
    }

    #highlightLiteral(entryEl: HTMLElement, query: string): number {
      const article = entryEl.querySelector('.lb-entry');
      if (!article || query.length === 0) return 0;

      const pattern = new RegExp(this.#escapeRegex(query), 'gi');
      let hits = 0;

      article.querySelectorAll(SEARCH_TARGETS).forEach((target) => {
        hits += this.#highlightInRoot(target, pattern, 'ls-hit');
      });

      return hits;
    }

    #highlightFuseMatches(entryEl: HTMLElement, matches: FuseMatch[]): number {
      const article = entryEl.querySelector('.lb-entry');
      if (!article) return 0;

      let hits = 0;

      for (const match of matches) {
        const key = match.key ?? '';
        const selector = FIELD_SELECTORS[key];
        const value = match.value ?? '';
        if (!selector || !value) continue;

        for (const [start, end] of match.indices ?? []) {
          const substring = value.slice(start, end + 1);
          if (!substring) continue;

          const pattern = new RegExp(this.#escapeRegex(substring), 'gi');
          article.querySelectorAll(selector).forEach((target) => {
            hits += this.#highlightInRoot(target, pattern, 'ls-hit ls-hit--approx');
          });
        }
      }

      return hits;
    }

    #handleInput(raw: string) {
      const query = raw.trim();

      this.#clearHighlights();
      this.#clearApproxBadges();

      if (!query) {
        this.#showAll(false);
        return;
      }

      const fuseById = new Map(
        this.#fuse!.search(query).map((result) => [result.item.id, result]),
      );

      let visible = 0;
      let exactEntries = 0;
      let approxEntries = 0;
      let totalHits = 0;

      this.#entries?.forEach((el) => {
        const id = el.dataset.entryId!;
        const literalHits = this.#highlightLiteral(el, query);

        if (literalHits > 0) {
          el.style.display = '';
          this.#setEntryOpen(id, true);
          this.#setApproxBadge(el, false);
          totalHits += literalHits;
          exactEntries++;
          visible++;
          return;
        }

        const fuseResult = fuseById.get(id);
        if (!fuseResult) {
          el.style.display = 'none';
          this.#setEntryOpen(id, false);
          this.#setApproxBadge(el, false);
          return;
        }

        const fuzzyHits = this.#highlightFuseMatches(
          el,
          (fuseResult.matches ?? []) as FuseMatch[],
        );

        if (fuzzyHits > 0) {
          el.style.display = '';
          this.#setEntryOpen(id, true);
          this.#setApproxBadge(el, true);
          totalHits += fuzzyHits;
          approxEntries++;
          visible++;
          return;
        }

        /* Fuse marcó la entrada pero el DOM no pudo resaltar: no mostrar */
        el.style.display = 'none';
        this.#setEntryOpen(id, false);
        this.#setApproxBadge(el, false);
      });

      this.#setCount(visible, exactEntries, approxEntries, totalHits, query);
    }

    #showAll(clearHighlights = true) {
      if (clearHighlights) {
        this.#clearHighlights();
        this.#clearApproxBadges();
      }
      this.#entries?.forEach((el) => {
        el.style.display = '';
        const id = el.dataset.entryId;
        if (id) this.#setEntryOpen(id, false);
      });
      this.#setCount(null, null, null, null, '');
    }

    #setCount(
      entries: number | null,
      exactEntries: number | null,
      approxEntries: number | null,
      hits: number | null,
      query: string,
    ) {
      if (!this.#countEl) return;
      if (
        entries === null ||
        exactEntries === null ||
        approxEntries === null ||
        hits === null ||
        !query
      ) {
        this.#countEl.textContent = '';
        this.#countEl.removeAttribute('title');
        return;
      }

      const entryLabel = entries === 1 ? 'entrada' : 'entradas';
      const hitLabel = hits === 1 ? 'vez' : 'veces';
      const parts: string[] = [`${hits} ${hitLabel}`, `${entries} ${entryLabel}`];

      if (exactEntries > 0 && approxEntries > 0) {
        const exactLabel = exactEntries === 1 ? 'exacta' : 'exactas';
        const approxLabel = approxEntries === 1 ? 'aprox' : 'aprox';
        parts.push(`${exactEntries} ${exactLabel} · ${approxEntries} ${approxLabel}`);
      } else if (approxEntries > 0) {
        const approxLabel = approxEntries === 1 ? 'aprox' : 'aprox';
        parts.push(`${approxEntries} ${approxLabel}`);
      }

      const summary = parts.join(' · ');
      this.#countEl.textContent = summary;
      this.#countEl.title =
        `${hits} coincidencias de «${query}» en ${entries} ${entryLabel}` +
        (approxEntries > 0 ? ` (${approxEntries} aproximadas)` : '');
    }
  }

  /* Registro idempotente: evita errores si el script se evalúa dos veces */
  if (!customElements.get('logbook-search')) {
    customElements.define('logbook-search', LogbookSearch);
  }
</script>

<style>
  /* Custom element como bloque */
  logbook-search,
  .ls-host {
    display: block;
    margin-bottom: 2.5rem;      /* 40px: separación antes del timeline */
  }

  /* ── Contenedor del input ────────────────────────────────────────────── */
  .ls-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 560px;           /* no ocupa todo el ancho: DESIGN §5 */
  }

  /* ── Icono ───────────────────────────────────────────────────────────── */
  .ls-icon {
    position: absolute;
    left: 0.875rem;
    display: flex;
    align-items: center;
    color: #A1A1AA;
    pointer-events: none;
    transition: color 150ms ease;
  }

  /* ── Campo de búsqueda ───────────────────────────────────────────────── */
  .ls-input {
    width: 100%;
    min-height: 44px;           /* área táctil mínima: DESIGN §8 */
    padding: 0.625rem 10.5rem 0.625rem 2.625rem; /* espacio para icono y contador largo */

    background-color: #111111;  /* Surface 1 */
    border: 1px solid #27272A;
    border-radius: 6px;
    color: #EDEDED;             /* text-primary */

    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;       /* 13px: monospace, ligeramente más pequeño */

    outline: none;
    transition: border-color 200ms ease;

    /* Elimina el botón nativo del input[type=search] en Webkit */
    appearance: none;
    -webkit-appearance: none;
  }

  .ls-input::placeholder {
    color: #3F3F46;             /* border-hover: discreto, no distrae */
  }

  /* Quitar el icono nativo de búsqueda y el botón de borrar en Webkit */
  .ls-input::-webkit-search-decoration,
  .ls-input::-webkit-search-cancel-button,
  .ls-input::-webkit-search-results-button { display: none; }

  .ls-input:focus {
    border-color: #14B8A6;      /* acento primario al enfocar */
  }

  .ls-input:focus + .ls-icon,
  .ls-wrapper:focus-within .ls-icon {
    color: #14B8A6;
  }

  /* ── Contador de resultados ──────────────────────────────────────────── */
  .ls-count {
    position: absolute;
    right: 0.875rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;       /* 11px */
    color: #A1A1AA;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 150ms ease;
  }

  /* Sin resultados: el contador se pone en rojo error */
  .ls-count:empty {
    display: none;
  }

  /* Resaltado de coincidencias en entradas visibles */
  :global(#bitacora mark.ls-hit) {
    background-color: rgba(20, 184, 166, 0.18);
    color: inherit;
    padding: 0.05em 0.12em;
    margin: 0 -0.02em;
    border-radius: 2px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  :global(#bitacora .lb-entry__terminal-text mark.ls-hit) {
    background-color: rgba(20, 184, 166, 0.24);
  }

  :global(#bitacora .inline-code mark.ls-hit),
  :global(#bitacora mark.ls-hit .inline-code) {
    background-color: rgba(20, 184, 166, 0.3);
    border-color: rgba(20, 184, 166, 0.45);
  }
  :global(#bitacora mark.ls-hit--approx) {
    background-color: rgba(245, 158, 11, 0.2);
  }

  :global(#bitacora .lb-entry__terminal-text mark.ls-hit--approx) {
    background-color: rgba(245, 158, 11, 0.28);
  }

  :global(#bitacora .ls-approx) {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5rem;
    padding: 0.1em 0.35em;
    font-family: var(--font-mono, monospace);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: #fbbf24;
    background-color: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 3px;
  }
</style>
